# TecniUrbano — copiar a .env.local y completar con valores del proyecto
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Mercado Pago. MP_ACCESS_TOKEN es server-only (sin prefijo VITE_ a propósito):
# nunca debe llegar al bundle del navegador. Usar credenciales TEST- en desarrollo.
MP_ACCESS_TOKEN=your_mercadopago_access_token
MP_PUBLIC_KEY=your_mercadopago_public_key

# Geocoding y mapa de "Zona de trabajo": Nominatim (OpenStreetMap) + Leaflet.
# No hace falta ninguna variable de entorno ni cuenta — a diferencia de
# Mapbox (que pide tarjeta para crear la cuenta), ninguno de los dos requiere
# API key. Ver api/_lib/geocoding.ts para el detalle de la política de uso.
